# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov
*.prof

# Go workspace file
go.work
go.work.sum

# Local build outputs and caches
/bin/
/.cache/
/.gocache/

# env file
.env
.env.*

# Secrets (none exist here, but these must never be committed if one appears)
credentials.json
*.key
*.pem

# Claude Code local settings
.claude/settings.local.json

# Editor / OS (kept in the repository because work spans machines)
.DS_Store
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.code-workspace
